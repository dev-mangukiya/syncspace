# ─── SyncSpace Environment Configuration ─────────────────
# Copy this file to .env and fill in your values
# Required vars are marked with [REQUIRED]

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=syncspace
POSTGRES_PASSWORD=syncspace_dev           # [REQUIRED] Change in production
POSTGRES_DB=syncspace

# ── Authentication ────────────────────────────────────────
JWT_SECRET=change-this-to-a-real-secret-in-production  # [REQUIRED] Min 32 chars in production
# Generate with: openssl rand -hex 32

# ── Server ────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000
ENV=development                           # Set to "production" for strict mode

# ── Frontend URLs (used by Next.js) ──────────────────────
NEXT_PUBLIC_WS_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_EXEC_SERVICE_URL=http://localhost:8081

# ── AI Assistant ──────────────────────────────────────────
# [REQUIRED] for AI features. Get a free key at https://console.groq.com/keys
# Fallback model: openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# ── Exec Service ──────────────────────────────────────────
# Shared secret between ws-server and exec-service (generate with: openssl rand -hex 32)
EXEC_SERVICE_SECRET=
